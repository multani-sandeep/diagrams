        stroke: "#0277bd"
      }
      tooltip: "Azure SQL Database\n\nTier: Business Critical (Zone-redundant)\nReplicas: 3 (across AZ1, AZ2, AZ3)\n\nGDPR Data:\n- Customer PII (EU residents)\n- GDPR audit logs\n\nResidency: West Europe only\nBackup: GRS (paired to North Europe)\n\n⚠️ NO cross-border replication to US/APAC"
    }

    redisEU: Azure Redis Cache\n(Premium) {
      shape: rectangle
      style: {
        fill: "#ef5350"
        stroke: "#c62828"
      }
      tooltip: "Azure Redis Cache\n\nTier: Premium (Zone-redundant)\nReplicas: 2 (AZ1, AZ2)\n\nResidency: West Europe only"
    }

    blobEU: Azure Blob Storage\n(LRS) {
      shape: cylinder
      style: {
