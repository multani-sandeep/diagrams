# ====================
# Architecture Notes
# ====================

architectureNotes: {
  near: top-right
  label: "L3 Deployment Architecture"
  shape: rectangle
  style: {
    fill: "#e8f5e9"
    stroke: "#388e3c"
    stroke-width: 2
  }

  note1: "High Availability:" {
    shape: text
    style: {
      font-size: 12
      bold: true
    }
  }

  note1a: "  • Zone-redundant services (99.99% SLA)" {
    shape: text
    style.font-size: 10
  }

  note1b: "  • Auto-scaling: 2-10 instances per AZ" {
    shape: text
    style.font-size: 10
  }

  note1c: "  • Geo-distributed failover" {
    shape: text
    style.font-size: 10
  }

  note2: "Data Residency:" {
    shape: text
    style: {
      font-size: 12
      bold: true
    }
  }

  note2a: "  • Customer PII stays in origin region" {
    shape: text
    style.font-size: 10
  }

  note2b: "  • Only metadata crosses borders" {
    shape: text
    style.font-size: 10
  }

  note2c: "  • GDPR-compliant EU data isolation" {
    shape: text
    style.font-size: 10
  }

  note3: "Network Performance:" {
    shape: text
    style: {
      font-size: 12
      bold: true
    }
  }

  note3a: "  • Cloudflare: 200+ PoPs globally" {
    shape: text
    style.font-size: 10
  }

  note3b: "  • Cross-region latency: 80-220ms" {
    shape: text
    style.font-size: 10
  }

  note3c: "  • TLS 1.3 for all traffic" {
    shape: text
    style.font-size: 10
  }
}

# ====================
# Scenarios: AS-IS vs TO-BE
# ====================

scenarios: {
  asIs: {
    scenarioNote.label: "L3 Deployment View - As-Is"

    # Hide CRM integration
    externalSystems.crm.class: hidden

    (azureEastUS.az1US.appSvc1a -> externalSystems.crm)[*].class: hidden
    (azureWestEU.az1EU.appSvc2a -> externalSystems.crm)[*].class: hidden
    (azureSEAsia.az1SEA.appSvc3a -> externalSystems.crm)[*].class: hidden
  }

  toBe: {
    scenarioNote: {
      label: "L3 Deployment View - To-Be"
      link: "https://raw.githubusercontent.com/multani-sandeep/diagrams/refs/heads/public/pub-1/context-l3-deployment/asIs.svg"
    }

    # Show CRM integration
    externalSystems.crm.style.opacity: 1

    azureEastUS.az1US.appSvc1a -> externalSystems.crm: "🆕 CRM Sync\n(Account creation)" {
      style: {
        stroke: "#00897b"
        stroke-width: 2
      }
      tooltip: "Backend → CRM Integration\n\nTrigger: Account creation event\nProtocol: HTTPS + OAuth 2.0\nData: emailAddress, contactPreferences\n\nData Residency:\n- US accounts: Synced from US East\n- EU accounts: Synced from West EU (GDPR)\n- APAC accounts: Synced from SE Asia"
    }

    azureWestEU.az1EU.appSvc2a -> externalSystems.crm: "🆕 CRM Sync\n(Account creation)" {
      style: {
        stroke: "#00897b"
        stroke-width: 2
      }
      tooltip: "GDPR Compliant CRM Sync\n\nEU customer data sent from EU region only\nNo cross-border PII transfer"
    }

    azureSEAsia.az1SEA.appSvc3a -> externalSystems.crm: "🆕 CRM Sync\n(Account creation)" {
      style: {
        stroke: "#00897b"
        stroke-width: 2
      }
      tooltip: "APAC CRM Sync\n\nCompliance: PDPA, Privacy Act\nData localization requirements met"
    }
  }
}
