        stroke: "#558b2f"
      }
      tooltip: "Azure Blob Storage\n\nRedundancy: LRS\nResidency: West Europe only\n\n⚠️ GDPR: No replication outside EU"
    }
  }

  az1EU.appSvc2a -> dataServicesEU.sqlEU: Reads/Writes {
    style: {
      stroke: "#0277bd"
      stroke-width: 2
    }
  }

  az1EU.appSvc2a -> dataServicesEU.redisEU: Cache ops {
    style: {
      stroke: "#c62828"
