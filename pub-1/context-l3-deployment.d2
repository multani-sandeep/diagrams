# ====================
# External Systems
# ====================

externalSystems: External Systems {
  style: {
    fill: "#f5f5f5"
    stroke: "#9e9e9e"
    stroke-width: 2
  }

  eCommerce: eCommerce Platform\n(3rd Party SaaS) {
    shape: cylinder
    style: {
      fill: "#e8f5e9"
      stroke: "#388e3c"
    }
    tooltip: "External System\n\nLocation: US-based SaaS\nConnectivity: Public internet (HTTPS)\nData: Product catalog, orders\n\nLatency:\n- US East: ~50ms\n- West EU: ~120ms\n- SE Asia: ~200ms"
  }

  loyalty: Loyalty Platform\n(3rd Party SaaS) {
    shape: cloud
    style: {
      fill: "#fce4ec"
      stroke: "#c2185b"
    }
    tooltip: "External System\n\nLocation: Multi-region SaaS\nConnectivity: Public internet (HTTPS)\nData: Customer loyalty points\n\nRegional endpoints:\n- US: us.loyalty.com\n- EU: eu.loyalty.com\n- APAC: apac.loyalty.com"
  }

  crm: CRM Platform\n(New - 3rd Party SaaS) {
    shape: cylinder
    style: {
      fill: "#e1f5fe"
      stroke: "#00897b"
      opacity: 0
    }
    tooltip: "External System (TO-BE)\n\nLocation: US-based SaaS\nConnectivity: Public internet (HTTPS)\nData: Customer master data\n\nData Sync:\n- Direction: One-way (Azure → CRM)\n- Frequency: Real-time (event-driven)\n- PII Handling: Encrypted in transit"
  }
}

# ====================
# Network Flows
# ====================

# Users to Cloudflare
users.usersAmericas -> cloudflare.waf: HTTPS {
  style: {
    stroke: "#ff6b35"
    stroke-width: 2
  }
}

users.usersEurope -> cloudflare.waf: HTTPS {
  style: {
    stroke: "#ff6b35"
    stroke-width: 2
  }
}

users.usersAPAC -> cloudflare.waf: HTTPS {
  style: {
    stroke: "#ff6b35"
    stroke-width: 2
  }
}

# Cloudflare to Azure regions (geo-routed)
cloudflare.waf -> azureEastUS.az1US.apiGW1a: "Americas Traffic\n(Geo-routed)" {
  style: {
    stroke: "#0078d4"
    stroke-width: 3
  }
  tooltip: "Traffic Route: Americas\n\nLatency: ~20-50ms\nBandwidth: Up to 10 Gbps\nProtocol: HTTPS (TLS 1.3)"
}

cloudflare.waf -> azureWestEU.az1EU.apiGW2a: "Europe Traffic\n(Geo-routed)" {
  style: {
    stroke: "#0078d4"
    stroke-width: 3
  }
  tooltip: "Traffic Route: Europe\n\nLatency: ~10-30ms\nBandwidth: Up to 10 Gbps\nProtocol: HTTPS (TLS 1.3)\n\nGDPR: EU traffic stays in EU region"
}

cloudflare.waf -> azureSEAsia.az1SEA.apiGW3a: "APAC Traffic\n(Geo-routed)" {
  style: {
    stroke: "#0078d4"
    stroke-width: 3
  }
  tooltip: "Traffic Route: APAC\n\nLatency: ~15-40ms\nBandwidth: Up to 10 Gbps\nProtocol: HTTPS (TLS 1.3)"
}

# Cross-region replication (metadata only, not PII)
azureEastUS.dataServicesUS.redisUS <-> azureWestEU.dataServicesEU.redisEU: "Metadata Replication\n(Non-PII only)" {
  style: {
    stroke: "#9c27b0"
    stroke-width: 1
    stroke-dash: 3
  }
  tooltip: "Cross-Region Replication\n\nData: Non-PII metadata only\n- Product catalog cache\n- Configuration settings\n- Feature flags\n\n⚠️ EXCLUDED:\n- Customer PII (GDPR)\n- Transactional data\n- Session state\n\nLatency: ~80ms\nProtocol: Private Link"
}

azureWestEU.dataServicesEU.redisEU <-> azureSEAsia.dataServicesSEA.redisSEA: "Metadata Replication\n(Non-PII only)" {
  style: {
    stroke: "#9c27b0"
    stroke-width: 1
    stroke-dash: 3
  }
  tooltip: "Cross-Region Replication\n\nData: Non-PII metadata only\nLatency: ~180ms\nProtocol: Private Link"
}

azureEastUS.dataServicesUS.redisUS <-> azureSEAsia.dataServicesSEA.redisSEA: "Metadata Replication\n(Non-PII only)" {
  style: {
    stroke: "#9c27b0"
    stroke-width: 1
    stroke-dash: 3
  }
  tooltip: "Cross-Region Replication\n\nData: Non-PII metadata only\nLatency: ~220ms\nProtocol: Private Link"
}

