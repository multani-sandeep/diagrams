# ============================================================================
# L3 Deployment View - Mobile Commerce Architecture
# ============================================================================
#
# This diagram shows the deployment architecture with focus on:
# - Azure regional resources and availability zones
# - Data residency and compliance requirements
# - Network topology and security boundaries
# - Cross-region replication patterns
#
# Based on: /Users/sandeep/Documents/multani-sandeep/diagrams/pub-1/context.d2
# ============================================================================

direction: right

classes: {
  hidden: {
    style.opacity: 0
  }
  legacy: {
    style.opacity: .2
  }
}

# Scenario switcher link
scenarioNote: {
  label: "L3 Deployment View - As-Is . Click here to see the To-Be"
  link: "https://raw.githubusercontent.com/multani-sandeep/diagrams/refs/heads/public/pub-1/context-l3-deployment/toBe.svg"
  near: top-left
  shape: rectangle
  style.fill: "#fff9c4"
  style.stroke: "#f57f17"
  style.font-size: 14
}

# ====================
# External Clients
# ====================

internet: Internet {
  shape: cloud
  style: {
    fill: "#e0e0e0"
    stroke: "#616161"
    stroke-width: 2
  }
}

users: Global Users {
  shape: rectangle
  style: {
    fill: "#e3f2fd"
    stroke: "#1976d2"
    stroke-width: 2
  }

  usersAmericas: "Americas Users\n(US, Canada, LATAM)" {
    shape: person
    style.fill: "#bbdefb"
  }

  usersEurope: "European Users\n(UK, EU)" {
    shape: person
    style.fill: "#bbdefb"
  }

  usersAPAC: "APAC Users\n(ANZ, SEA)" {
    shape: person
    style.fill: "#bbdefb"
  }
}

# ====================
# CDN & WAF Layer
# ====================

cloudflare: Cloudflare Global Network {
  shape: rectangle
  style: {
    fill: "#fff3e0"
    stroke: "#ff6b35"
    stroke-width: 3
  }

  waf: WAF & DDoS Protection {
    shape: hexagon
    style: {
      fill: "#ff6b35"
      stroke: "#d94d1a"
      stroke-width: 2
    }
    tooltip: "Cloudflare WAF\n\nFeatures:\n- DDoS protection\n- Bot management\n- Rate limiting\n- SSL/TLS termination\n- Geo-routing"
  }

  edgeCache: Edge Caching (200+ PoPs) {
    shape: rectangle
    style: {
      fill: "#ffe0b2"
      stroke: "#f57c00"
    }
    tooltip: "Global CDN:\n- Static assets\n- API response caching\n- Image optimization"
  }
}

# ====================
# Azure Region: East US
# ====================

azureEastUS: Azure Region: East US {
  style: {
    fill: "#e6f3ff"
    stroke: "#0078d4"
    stroke-width: 4
  }

  dataResidencyUS: "📍 Data Residency: United States" {
    shape: text
    # near: top-center
    style: {
      font-size: 13
      bold: true
      fill: "#bbdefb"
    }
  }

  complianceUS: "Compliance: SOC 2, CCPA, PCI-DSS" {
    shape: text
    # near: top-center
    style.font-size: 11
  }

  az1US: Availability Zone 1 {
    style: {
      fill: "#cce5ff"
      stroke: "#0078d4"
      stroke-width: 2
      stroke-dash: 5
    }

    apiGW1a: API Gateway\n(Primary - AZ1) {
      shape: rectangle
      style: {
        fill: "#0078d4"
        stroke: "#005a9e"
        stroke-width: 2
      }
      tooltip: "Azure API Management\n\nAZ: East US - Zone 1\nSKU: Premium (99.99% SLA)\n\nFeatures:\n- API throttling\n- Request/response transformation\n- OAuth 2.0 validation\n- Request logging"
    }

    appSvc1a: App Service\n(.NET 8 Backend - AZ1) {
      shape: rectangle
      style: {
        fill: "#50e6ff"
        stroke: "#0078d4"
        stroke-width: 2
      }
      tooltip: "Azure App Service\n\nAZ: East US - Zone 1\nSKU: P3V3 (Zone redundant)\nRuntime: .NET 8\nInstances: Auto-scale 2-10\n\nData Access:\n- Redis Cache (local AZ)\n- Azure SQL (zone-redundant)\n- Blob Storage (LRS)"
    }

    apiGW1a -> appSvc1a: Routes to {
      style: {
        stroke: "#0078d4"
        stroke-width: 2
      }
    }
  }

  az2US: Availability Zone 2 {
    style: {
      fill: "#cce5ff"
      stroke: "#0078d4"
      stroke-width: 2
      stroke-dash: 5
    }

    apiGW1b: API Gateway\n(Standby - AZ2) {
      shape: rectangle
      style: {
        fill: "#0078d4"
        stroke: "#005a9e"
        stroke-width: 2
      }
      tooltip: "Azure API Management\n\nAZ: East US - Zone 2\nSKU: Premium (Zone redundant)\n\nRole: Active-Active with AZ1"
    }

    appSvc1b: App Service\n(.NET 8 Backend - AZ2) {
      shape: rectangle
      style: {
        fill: "#50e6ff"
        stroke: "#0078d4"
        stroke-width: 2
      }
      tooltip: "Azure App Service\n\nAZ: East US - Zone 2\nSKU: P3V3 (Zone redundant)\nRuntime: .NET 8\nInstances: Auto-scale 2-10"
    }

    apiGW1b -> appSvc1b: Routes to {
      style: {
        stroke: "#0078d4"
        stroke-width: 2
      }
    }
  }

  dataServicesUS: Data Services (Zone-Redundant) {
    style: {
      fill: "#b3d9ff"
      stroke: "#0078d4"
      stroke-width: 2
      stroke-dash: 3
    }

    sqlUS: Azure SQL Database\n(Zone-redundant) {
      shape: cylinder
      style: {
        fill: "#4fc3f7"
        stroke: "#0277bd"
      }
      tooltip: "Azure SQL Database\n\nTier: Business Critical (Zone-redundant)\nReplicas: 3 (across AZ1, AZ2, AZ3)\n\nData Classification:\n- PII: Customer accounts\n- Transactional: Orders, cart\n\nResidency: US East only\nBackup: GRS (paired to West US 2)"
    }

    redisUS: Azure Redis Cache\n(Premium) {
      shape: rectangle
      style: {
        fill: "#ef5350"
        stroke: "#c62828"
      }
      tooltip: "Azure Redis Cache\n\nTier: Premium (Zone-redundant)\nReplicas: 2 (AZ1, AZ2)\n\nUse Cases:\n- Session state\n- API response cache (60s TTL)\n- Rate limiting counters\n\nResidency: US East only"
    }

    blobUS: Azure Blob Storage\n(LRS) {
      shape: cylinder
      style: {
        fill: "#9ccc65"
        stroke: "#558b2f"
      }
      tooltip: "Azure Blob Storage\n\nRedundancy: LRS (Locally redundant)\n\nData:\n- Product images\n- User uploads\n- Architecture diagrams\n\nResidency: US East only\nNo cross-border replication"
    }
  }

  az1US.appSvc1a -> dataServicesUS.sqlUS: Reads/Writes {
    style: {
      stroke: "#0277bd"
      stroke-width: 2
    }
  }

  az1US.appSvc1a -> dataServicesUS.redisUS: Cache ops {
    style: {
      stroke: "#c62828"
      stroke-width: 1
      stroke-dash: 3
    }
  }

  az2US.appSvc1b -> dataServicesUS.sqlUS: Reads/Writes {
    style: {
      stroke: "#0277bd"
      stroke-width: 2
    }
  }

  az2US.appSvc1b -> dataServicesUS.redisUS: Cache ops {
    style: {
      stroke: "#c62828"
      stroke-width: 1
      stroke-dash: 3
    }
  }
}

