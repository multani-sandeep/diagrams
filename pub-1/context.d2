# User interactions
user -> fe: Uses
user -> fe: Views products & cart
user -> fe: Registers account
user -> fe: Earns loyalty rewards
user -> fe: Places orders

# Frontend to Cloudflare with data flows
fe -> cloudflare: Requests {
  style: {
    stroke: "#ff6b35"
    stroke-width: 3
  }
}

fe -> cloudflare: "READ: Product data\nREAD: Loyalty data" {
  style: {
    stroke: "#4caf50"
    stroke-width: 2
    stroke-dash: 3
  }
}

fe -> cloudflare: "CREATE: Account data\nCREATE: Loyalty data\nCREATE: Cart data\nCREATE: Order data" {
  style: {
    stroke: "#ff9800"
    stroke-width: 2
    stroke-dash: 3
  }
}

# Cloudflare to Azure regions (load balanced)
cloudflare -> azure.regionEastUS.apiGW1: "Route: Americas\n(Protected traffic)" {
  style: {
    stroke: "#0078d4"
    stroke-width: 3
  }
}

cloudflare -> azure.regionWestEU.apiGW2: "Route: Europe\n(Protected traffic)" {
  style: {
    stroke: "#0078d4"
    stroke-width: 3
  }
}

cloudflare -> azure.regionSoutheastAsia.apiGW3: "Route: Asia-Pacific\n(Protected traffic)" {
  style: {
    stroke: "#0078d4"
    stroke-width: 3
  }
}

# Frontend 3rd party integrations
fe -> thirdParty: Integrates with {
  style: {
    stroke: "#f57c00"
    stroke-width: 2
  }
}

# Backend to eCommerce client systems - Products, Orders, Account, Cart
azure.*.appSvc* -> clientSystems: "⚠️ READ: Product data (CHANGED)\n   WRITE: Order data\n⚠️ SYNC: Account data (CHANGED)\n   SYNC: Cart data" {
  style: {
    stroke: "#7b1fa2"
    stroke-width: 3
    stroke-dash: 3
  }
  tooltip: "AS-IS → TO-BE Migration Changes:\n\n1. READ Product data:\n   - Legacy: XML response with nested &lt;product&gt; elements\n   - New: REST JSON with flat product objects\n   - Fields renamed: itemId → sku, description → name\n\n2. SYNC Account data:\n   - Legacy: SOAP request/response\n   - New: REST JSON request/response\n   - Auth changed: Basic → OAuth 2.0\n   - New required fields: loyaltyId, preferences"
}

# Backend to 3rd party loyalty services - Only Loyalty
azure.*.appSvc* -> loyaltyServices: "⚠️ SYNC: Loyalty data (NEW ATTRS)" {
  style: {
    stroke: "#c2185b"
    stroke-width: 3
    stroke-dash: 3
  }
  tooltip: "AS-IS → TO-BE Migration Changes:\n\nSYNC Loyalty data - Response Schema:\n\nLegacy attributes:\n- customerId\n- points\n- tier\n- lastUpdated\n\nNew platform adds:\n+ rewardBalance (separate from points)\n+ tierExpiryDate\n+ availableRewards[] array\n+ pointsHistory[] array\n+ preferredRedemption\n+ externalLoyaltyId\n\nRequest schema unchanged"
}


*.*.appSvc* -> loyaltyServicesNew: {
  style: {
    stroke: "#c2185b"
    stroke-width: 3
    stroke-dash: 3
    opacity: 0
  }
}
*.*.appSvc* -> clientSystemsNew: {
  style: {
    stroke: "#7b1fa2"
    stroke-width: 3
    stroke-dash: 3
    opacity: 0
  }
}
*.*.appSvc* -> newCRM: {
  style: {
    stroke: "#00897b"
    stroke-width: 3
    stroke-dash: 3
    opacity: 0
  }
}

